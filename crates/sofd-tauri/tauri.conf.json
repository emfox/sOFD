{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sOFD",
  "version": "0.6.0",
  "identifier": "org.ofdspec.stele.reader",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "sOFD",
        "width": 1100,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "dragDropEnabled": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
