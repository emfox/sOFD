# ─── Rust / Cargo ───
/target/
**/*.rs.bk
*.pdb
*.profraw
*.profdata

# Legacy temp directory name kept for compatibility
/artifacts/

# ─── Build output ───
build/
dist/
# `flatpak-builder` keeps its work tree beside the manifest, which a local run
# leaves in the current directory.
.flatpak-builder/
flatpak-repo/
*.dll
*.dylib
*.so
*.a
*.lib
*.exe

# WASM artifacts produced by wasm-pack
pkg/
wasm-pack.log
*.wasm

# C headers generated by cbindgen at build time
include/sofd.h

# ─── Test and benchmark output ───
/criterion/
*.svg
!docs/**/*.svg

# ─── Generated documentation ───
/docs/book/
/doc/

# ─── Python ───
__pycache__/
*.py[cod]

# ─── IDE / editor ───
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.project
.classpath

# ─── Operating system ───
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ─── Logs and local data ───
*.log
logs/
/tmp/

# ─── Local test data: large, never committed ───
/tests/fixtures/large/
/tests/fixtures/private/
# Third-party samples fetched by scripts/sample_fetch.py. They are not ours to
# redistribute and they are large, so they stay out of the tree; the pinned list
# in that script is what a fresh checkout has, and the `.fetched.json` written
# beside them records the hashes of what this working copy already holds.
*.ofd
# Fetched samples stay out even though fixtures generally do not: the rule
# below would otherwise re-include them.
/tests/fixtures/ofdrw/
/tests/fixtures/gbt33190-samples/
!tests/fixtures/**/*.ofd
!docs/**/*.ofd
!compliance/fixtures/**/*.ofd

# ─── Secrets: must never be committed ───
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.jks
secrets/
credentials.toml

# ─── Local workspace config overrides ───
.cargo/config.toml
!.cargo/config.toml.example

# ─── Coverage reports ───
/coverage/
*.profraw
lcov.info
tarpaulin-report.html
