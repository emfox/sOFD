      <ofd:TextObject ID="125" Boundary="38.83 47.61 96.98 5.57" Font="9" Size="5.56">
        <ofd:FillColor Value="0 0 8" ColorSpace="5"/>
        <ofd:TextCode X="0.32" Y="4.78" DeltaX="5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.29 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56">二、进一步促进高等教育入学机会公平</ofd:TextCode>
      </ofd:TextObject>
      <ofd:TextObject ID="126" Boundary="49.58 57.93 136.67 5.57" Font="9" Size="5.56">
        <ofd:FillColor Value="0 0 8" ColorSpace="5"/>
        <ofd:TextCode X="0.69" Y="4.78" DeltaX="5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82">促进区域入学机会公平。各地要认真贯彻落实中央关于</ofd:TextCode>
      </ofd:TextObject>
      <ofd:TextObject ID="127" Boundary="27.35 68.24 158.89 5.57" Font="9" Size="5.56">
        <ofd:FillColor Value="0 0 8" ColorSpace="5"/>
        <ofd:TextCode X="0.69" Y="4.78" DeltaX="5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56">促进教育公平的有关部署，在国家下达的年度本科、预科招生规</ofd:TextCode>
      </ofd:TextObject>
      <ofd:TextObject ID="128" Boundary="27.35 78.83 158.89 5.57" Font="9" Size="5.56">
        <ofd:FillColor Value="0 0 8" ColorSpace="5"/>
        <ofd:TextCode X="0.69" Y="4.78" DeltaX="5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56">模和经教育部备案的高职招生规模内，统筹好招生计划的增量安</ofd:TextCode>
      </ofd:TextObject>
      <ofd:TextObject ID="129" Boundary="27.49 89.15 125.29 5.57" Font="9" Size="5.56">
        <ofd:FillColor Value="0 0 8" ColorSpace="5"/>
        <ofd:TextCode X="0.55" Y="4.78" DeltaX="5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.82 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56 5.56">排和存量调整，合理编制跨省招生计划。继续实施</ofd:TextCode>
      </ofd:TextObject>
      <ofd:TextObject ID="130" Boundary="153.06 89.15 8.34 5.57" Font="9" Size="5.56">
